  "components": {
    "schemas": {
      "ApprovalInput": {
        "properties": {
          "artifact_hash": {
            "type": "string",
            "title": "Artifact Hash"
          },
          "input_hash": {
            "type": "string",
            "title": "Input Hash"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "artifact_hash",
          "input_hash"
        ],
        "title": "ApprovalInput"
      },
      "BriefInput": {
        "properties": {
          "brief": {
            "additionalProperties": true,
            "type": "object",
            "title": "Brief"
          },
          "mode": {
            "type": "string",
            "enum": [
              "fixture",
              "local"
            ],
            "title": "Mode",
            "default": "fixture"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "brief"
        ],
        "title": "BriefInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Input": {
        "properties": {},
        "additionalProperties": false,
        "type": "object",
        "title": "Input"
      },
      "LensInput": {
        "properties": {
          "run_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Run Id"
          },
          "fault": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "invalid_args",
                  "timeout",
                  "omit_evidence",
                  "wrong_snapshot",
                  "repeat_event"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Fault"
          },
          "mode": {
            "type": "string",
            "enum": [
              "fixture",
              "local"
            ],
            "title": "Mode",
            "default": "fixture"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "LensInput"
      },
      "Options": {
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "fixture",
              "local",
              "live",
              "replay"
            ],
            "title": "Mode",
            "default": "fixture"
          },
          "method": {
            "type": "string",
            "enum": [
              "lexical",
              "dense",
              "hybrid",
              "full_pack"
            ],
            "title": "Method",
            "default": "lexical"
          },
          "candidate": {
            "type": "string",
            "enum": [
              "broken",
              "normal"
            ],
            "title": "Candidate",
            "default": "broken"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Options"
      },
      "Query": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Query"
          },
          "brand": {
            "type": "string",
            "enum": [
              "luma",
              "veyra"
            ],
            "title": "Brand",
            "default": "luma"
          },
          "snapshot": {
            "type": "string",
            "enum": [
              "v1",
              "v2"
            ],
            "title": "Snapshot",
            "default": "v2"
          },
          "mode": {
            "type": "string",
            "enum": [
              "fixture",
              "local",
              "live",
              "replay"
            ],
            "title": "Mode",
            "default": "fixture"
          },
          "policy": {
            "type": "string",
            "enum": [
              "off",
              "exact",
              "semantic"
            ],
            "title": "Policy",
            "default": "semantic"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "query"
        ],
        "title": "Query"
      },
      "ResumeInput": {
        "properties": {
          "answers": {
            "additionalProperties": true,
            "type": "object",
            "title": "Answers"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ResumeInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}